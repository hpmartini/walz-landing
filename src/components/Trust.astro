---
// Fact block (owner decision): "Seit Generationen" is back as the first tile, the team size is
// derived from the published team page and Karsten Walz's own track record closes the row.
import { Picture } from 'astro:assets';
import team from '../data/team.json';
import teamPhoto from '../assets/photos/team.jpg';

const count = (test: (role: string) => boolean) => team.filter((m) => test(m.role)).length;
const qualifications = [
  [count((r) => r.includes('Steuerberater')), 'Steuerberater (zugleich Diplom-Betriebswirt FH)'],
  [count((r) => r.startsWith('Diplom-Betriebswirtin')), 'Diplom-Betriebswirtin (FH), M.Sc.'],
  [count((r) => r === 'Steuerfachwirtin'), 'Steuerfachwirtin'],
  [count((r) => r.startsWith('Steuerfachangestellte')), 'Steuerfachangestellte'],
  [count((r) => r === 'Officemanagerin'), 'Officemanagerin'],
  [count((r) => r.startsWith('Auszubildende')), 'Auszubildende'],
] as const;

const facts = [
  { value: 'Seit Generationen', label: 'Ihre Kanzlei in der Region', phrase: true },
  { value: String(team.length), label: 'Personen im Team', phrase: false },
  { value: 'seit 2000', label: 'Karsten Walz selbstständiger Steuerberater, seit 2004 alleiniger Kanzleiinhaber', phrase: true },
];
---

<section aria-labelledby="fakten-heading" class="py-14 md:py-24 bg-bg-alt">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 id="fakten-heading" class="text-3xl md:text-4xl font-bold text-primary mb-8 md:mb-10" data-reveal>Die Kanzlei in Fakten</h2>
    <dl class="grid md:grid-cols-3 gap-6" data-reveal-group>
      {facts.map((fact) => (
        <div class="flex flex-col-reverse justify-end text-center bg-white rounded-2xl p-5 md:p-8 border border-secondary/15 shadow-sm" data-trace data-spotlight>
          <dt class="text-text leading-relaxed">{fact.label}</dt>
          <dd class:list={['font-bold text-primary mb-2 leading-tight', fact.phrase ? 'text-2xl md:text-3xl' : 'text-3xl md:text-4xl']}>{fact.phrase ? fact.value : <><span class="sr-only">{fact.value}</span><span aria-hidden="true" class="tabular-nums" data-countup={fact.value}>{fact.value}</span></>}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-6 rounded-2xl overflow-hidden border border-secondary/20 shadow-sm" data-reveal data-clip>
      <Picture src={teamPhoto} formats={['avif', 'webp']} widths={[640, 960, 1280, 1754]} sizes="(min-width: 1200px) 1152px, 100vw" alt="Das Team der Kanzlei Karsten Walz" class="block w-full h-auto" />
    </div>
    <p class="mt-8 text-text max-w-3xl" data-reveal>
      Im Team: {qualifications.filter(([n]) => n > 0).map(([n, label]) => `${n} ${label}`).join(' · ')}.
      <a href="/team" class="ml-1 text-primary font-semibold underline decoration-secondary underline-offset-4 hover:text-primary-light">Alle Ansprechpartner ansehen</a>
    </p>
  </div>
</section>
