  rocket: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
  target: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-9 0a9 9 0 1018 0 9 9 0 10-18 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-5 0a5 5 0 1010 0 5 5 0 10-10 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-1 0a1 1 0 102 0 1 1 0 10-2 0"/></svg>`,
  chart: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19V5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19h16"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 15l3-3 3 2 4-6"/></svg>`,
  calculator: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 3h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"/></svg>`,
  document: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3h6l4 4v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 11h6M9 15h6"/></svg>`,
  users: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 20H2v-2a3 3 0 015.356-1.857"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 20v-2a5 5 0 0110 0v2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
