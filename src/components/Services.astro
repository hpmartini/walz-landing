---
import services from '../data/services.json';

const icons: Record<string, string> = {
  landing: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3.5h6l2 3V11H7V6.5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 11l-.5 2.5h4l-.5-2.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 11l-3.5 8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 11l3.5 8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 19.5h3.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.5 19.5H22"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15.5v2.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.5 16l-.5 1.5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.5 16l.5 1.5"/><circle stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" cx="12" cy="7.2" r="1.2"/></svg>`,
  rocket: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
  target: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-9 0a9 9 0 1018 0 9 9 0 10-18 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-5 0a5 5 0 1010 0 5 5 0 10-10 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 12m-1 0a1 1 0 102 0 1 1 0 10-2 0"/></svg>`,
  chart: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19V5"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19h16"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 15l3-3 3 2 4-6"/></svg>`,
  calculator: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 3h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01"/></svg>`,
  document: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3h6l4 4v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 11h6M9 15h6"/></svg>`,
  users: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 20H2v-2a3 3 0 015.356-1.857"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 20v-2a5 5 0 0110 0v2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  shield: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V7l8-4z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4"/></svg>`,
  file: `<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3h6l4 4v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6"/></svg>`,
};
---

<section class="py-20 md:py-24 bg-bg-alt">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-3xl md:text-4xl text-primary mb-4">
        Unsere Leistungen
      </h2>
      <div class="w-16 h-1 bg-secondary mx-auto" data-bar="center"></div>
      <p class="text-text max-w-2xl mx-auto mt-5">
        Von der Existenzgründung über die laufende Betreuung, bis hin zur Nachfolgeregelung: <br /> Wir schaffen Klarheit, Sicherheit und entlasten Sie im Alltag.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
      {services.map((service) => (
        <a
          href={`/leistungen/${service.slug}`}
          class="group min-w-0 bg-white p-8 rounded-xl shadow-sm border border-secondary/15 hover:border-secondary/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          data-spotlight
        >
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-secondary/10 text-secondary border border-secondary/20 mb-5 transition-all duration-300 group-hover:bg-secondary/15 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100" aria-hidden="true" set:html={icons[service.icon] ?? icons.file} />
          <h3 class="text-xl font-semibold text-primary mb-3 hyphens-auto break-words">
            {service.title}
          </h3>
          <p class="text-text mb-5 whitespace-pre-line">
            {service.shortDesc}
          </p>
          <span class="text-primary font-medium group-hover:text-primary-light transition-colors duration-300 inline-flex items-center gap-1">
            Mehr erfahren
            <svg class="w-4 h-4 transition-transform duration-300 motion-reduce:transition-none group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
