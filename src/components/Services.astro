---
import services from '../data/services.json';
---

<!-- Compact list instead of icon cards: Anliegen already routes by situation, this is the full index (audit V3 C1). -->
<section id="leistungen" class="py-12 md:py-20 bg-bg-alt scroll-mt-24">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="mb-6 md:mb-10" data-reveal>
      <h2 class="text-3xl md:text-4xl text-primary mb-4">
        Alle Leistungen
      </h2>
      <div class="w-16 h-1 bg-secondary" data-bar></div>
    </div>

    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 border-t border-secondary/20" data-reveal-group>
      {services.map((service) => (
        <li class="border-b border-secondary/20">
          <a
            href={`/leistungen/${service.slug}`}
            class="group flex items-start justify-between gap-4 py-4 min-w-0"
          >
            <span class="min-w-0">
              <span class="block text-lg font-semibold text-primary break-words group-hover:text-primary-light transition-colors duration-300">
                {service.heading ?? service.title}
              </span>
              <span class="block text-text text-sm mt-1">{service.shortDesc}</span>
            </span>
            <svg class="w-5 h-5 mt-1 shrink-0 text-secondary transition-transform duration-300 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
