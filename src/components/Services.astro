---
import services from '../data/services.json';

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section class="py-24 md:py-32 bg-bg-alt">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="relative" data-reveal>
      <span class="fx-chapter absolute right-0 -top-3 text-primary/10" aria-hidden="true">01</span>
      <p class="fx-eyebrow text-primary">Leistungen</p>
      <h2 class="fx-h-section mt-4">Unsere Leistungen</h2>
      <p class="text-text mt-5 max-w-2xl">
        Von der Existenzgründung bis zur laufenden Betreuung: Wir schaffen Klarheit, Sicherheit und entlasten Sie im Alltag.
      </p>
    </div>

    <!-- Signature interaction: flowing rows. Hover slides a mauve band in from
         the cursor's edge with an endless marquee; touch and reduced-motion
         users get the fully styled static rows. -->
    <ul class="mt-14 border-t border-primary/15" data-reveal-group>
      {services.map((service, idx) => (
        <li>
          <a
            href={`/leistungen/${service.slug}`}
            class="group relative block overflow-hidden border-b border-primary/15"
            data-flow-item
          >
            <div class="flex items-center gap-5 md:gap-8 px-1 py-5 md:py-6">
              <span class="fx-eyebrow text-text tabular-nums">{pad(idx)}</span>
              <h3 class="fx-h-row flex-1 min-w-0 hyphens-auto break-words transition-colors duration-300 group-hover:text-primary-light">
                {service.title}
              </h3>
              <svg class="w-5 h-5 shrink-0 text-secondary transition-transform duration-300 motion-reduce:transition-none group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>

            <div
              class="absolute inset-0 z-10 bg-primary flex items-center overflow-hidden"
              style="transform: translateY(101%);"
              data-flow-band
              aria-hidden="true"
            >
              <div class="flex w-max items-center gap-10 whitespace-nowrap will-change-transform px-6" data-flow-marquee>
                {[0, 1, 2, 3, 4, 5].map(() => (
                  <>
                    <span class="text-white uppercase font-light text-lg tracking-[0.02em]">{service.title}</span>
                    <span class="text-secondary text-xs" aria-hidden="true">◆</span>
                    <span class="text-white/90 text-lg font-light">{service.shortDesc}</span>
                    <span class="text-secondary text-xs" aria-hidden="true">◆</span>
                  </>
                ))}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10" data-reveal>
      <a
        href="/leistungen"
        class="inline-flex items-center gap-2 text-primary font-semibold a-underline transition-colors duration-300 hover:text-primary-light"
      >
        Alle Leistungen im Überblick
        <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
