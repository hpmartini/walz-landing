---
// "So läuft die Zusammenarbeit" (audit V2 9.4). Only steps the site already states; no durations, prices or deadlines.
const steps = [
  { title: 'Anfrage', text: 'Per Formular, Telefon oder E-Mail. Ein, zwei Sätze zu Ihrem Anliegen genügen.' },
  { title: 'Erstgespräch', text: 'Wir besprechen Ihre Situation und klären, ob und wie wir Sie unterstützen können.' },
  { title: 'Umfang und Vergütung', text: 'Vor der Beauftragung stimmen wir den Leistungsumfang und die Abrechnung mit Ihnen ab.' },
  { title: 'Start', text: 'Wir besprechen mit Ihnen, welche Unterlagen wir benötigen, und beginnen mit der Betreuung.' },
];
---

<section id="ablauf" aria-labelledby="ablauf-heading" class="py-14 md:py-24 bg-bg scroll-mt-24">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 id="ablauf-heading" class="text-3xl md:text-4xl font-bold text-primary mb-8 md:mb-10" data-reveal>So läuft die Zusammenarbeit</h2>
    <ol class="grid md:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-6" data-reveal-group>
      {steps.map((step, i) => (
        <li class="group bg-white rounded-xl p-6 md:p-8 border border-secondary/15 shadow-sm" data-trace data-spotlight>
          <div class="flex items-center gap-3 mb-2 md:block">
            <span class="flex shrink-0 items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold md:mb-4 transition-[box-shadow,scale] duration-500 ease-out group-hover:scale-110 group-hover:shadow-[0_0_0_6px_rgb(176_151_150/0.3)] motion-reduce:transition-none motion-reduce:group-hover:scale-100" aria-hidden="true">{i + 1}</span>
            <h3 class="text-xl font-semibold text-primary md:mb-2"><span class="sr-only">Schritt {i + 1}: </span>{step.title}</h3>
          </div>
          <p class="text-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
