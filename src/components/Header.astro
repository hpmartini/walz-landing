---
import services from '../data/services.json';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Startseite' },
  { href: '/leistungen', label: 'Leistungen', dropdown: true },
  { href: '/kanzlei', label: 'Kanzlei' },
  { href: '/team', label: 'Team' },
  { href: '/karriere', label: 'Karriere' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-sm border-b border-primary/10 transition-shadow duration-300">
  <div class="max-w-[1200px] mx-auto px-3 py-1.5 md:px-6 md:py-3">
    <nav class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="block" aria-label="Kanzlei Karsten Walz – Startseite">
        <img
          src="/images/brand/logo.png"
          alt="Kanzlei Karsten Walz – Steuerberater"
          width="500"
          height="70"
          class="h-9 md:h-11 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Navigation (promoted at lg — five items + phone + CTA squeeze at 768) -->
      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navItems.map((item) => (
          item.dropdown ? (
            <div class="relative group">
              <a
                href={item.href}
                class:list={[
                  'font-medium transition-colors duration-300 a-underline',
                  isActive(item.href) ? 'text-primary' : 'text-text hover:text-primary',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>

              <div class="absolute left-0 top-full pt-3 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-300 motion-reduce:transition-none">
                <div class="min-w-72 border border-primary/15 bg-white shadow-lg p-3">
                  <div class="fx-eyebrow text-text px-3 pb-2">Alle Leistungen</div>
                  <div class="h-px bg-primary/10 mb-2"></div>
                  <ul class="py-1">
                    {services.map((s) => (
                      <li>
                        <a
                          href={`/leistungen/${s.slug}`}
                          class:list={[
                            'block px-3 py-2 text-sm transition-colors duration-300',
                            pathname === `/leistungen/${s.slug}`
                              ? 'bg-secondary/10 text-primary'
                              : 'text-text hover:bg-secondary/10 hover:text-primary',
                          ]}
                        >
                          {s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'font-medium transition-colors duration-300 a-underline',
                isActive(item.href) ? 'text-primary' : 'text-text hover:text-primary',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          )
        ))}
      </div>

      <!-- CTA & Phone (phone number needs xl — at lg it wraps into the nav) -->
      <div class="hidden lg:flex items-center gap-6">
        <a href="tel:066914271" class="hidden xl:flex items-center gap-2 whitespace-nowrap text-text hover:text-primary transition-colors duration-300">
          <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">06691 4271</span>
        </a>
        <a href="/kontakt" class="bg-primary text-white px-6 py-2.5 text-sm font-bold uppercase tracking-[0.14em] transition-colors duration-300 hover:bg-primary-light">
          Kontakt
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-primary" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </nav>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="lg:hidden hidden border-t border-primary/10 overflow-hidden">
      <div class="flex flex-col gap-3 pb-4">
        <a href="/" class:list={['font-medium transition-colors duration-300', pathname === '/' ? 'text-primary' : 'text-text hover:text-primary']}>Startseite</a>

        <details class="group">
          <summary class:list={['cursor-pointer list-none font-medium transition-colors duration-300 flex items-center justify-between', isActive('/leistungen') ? 'text-primary' : 'text-text hover:text-primary']}>
            <span>Leistungen</span>
            <svg class="w-4 h-4 text-secondary transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="mt-2 pl-3 border-l border-primary/15">
            <a href="/leistungen" class="block py-2 text-sm text-text hover:text-primary transition-colors duration-300">Übersicht</a>
            {services.map((s) => (
              <a
                href={`/leistungen/${s.slug}`}
                class:list={[
                  'block py-2 text-sm transition-colors duration-300',
                  pathname === `/leistungen/${s.slug}` ? 'text-primary' : 'text-text hover:text-primary',
                ]}
              >
                {s.title}
              </a>
            ))}
          </div>
        </details>

        <a href="/kanzlei" class:list={['font-medium transition-colors duration-300', isActive('/kanzlei') ? 'text-primary' : 'text-text hover:text-primary']}>Kanzlei</a>
        <a href="/team" class:list={['font-medium transition-colors duration-300', isActive('/team') ? 'text-primary' : 'text-text hover:text-primary']}>Team</a>
        <a href="/karriere" class:list={['font-medium transition-colors duration-300', isActive('/karriere') ? 'text-primary' : 'text-text hover:text-primary']}>Karriere</a>

        <div class="pt-3 flex flex-col gap-3">
          <a href="tel:066914271" class="flex items-center gap-2 text-text hover:text-primary transition-colors duration-300">
            <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>06691 4271</span>
          </a>
          <a href="/kontakt" class="bg-primary text-white px-6 py-2.5 text-sm font-bold uppercase tracking-[0.14em] text-center transition-colors duration-300 hover:bg-primary-light">
            Kontakt
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const closeMenu = () => {
    if (!menu || !btn) return;
    menu.classList.add('hidden');
    menu.classList.remove('mt-4', 'pt-4');
    btn.setAttribute('aria-expanded', 'false');
  };

  const openMenu = () => {
    if (!menu || !btn) return;
    menu.classList.remove('hidden');
    menu.classList.add('mt-4', 'pt-4');
    btn.setAttribute('aria-expanded', 'true');
  };

  btn?.addEventListener('click', () => {
    if (!menu) return;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    expanded ? closeMenu() : openMenu();
  });

  window.addEventListener('resize', () => {
    // Reset state on breakpoint changes (desktop nav promotes at lg = 1024px)
    if (window.innerWidth >= 1024) closeMenu();
  });

  document.addEventListener('click', (e) => {
    // Close on navigation tap
    const a = (e.target as HTMLElement | null)?.closest?.('a');
    if (a && menu && !menu.classList.contains('hidden')) closeMenu();
  });
</script>
