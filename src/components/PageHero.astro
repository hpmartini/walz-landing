---
import { Picture } from 'astro:assets';
import headerPhoto from '../assets/team/header_Unterseite.jpg';
interface Props {
  title: string;
  subtitle?: string;
  /** Shorter band so the content below (e.g. the contact form) shows up sooner on phones. */
  compact?: boolean;
}

const { title, subtitle, compact = false } = Astro.props;
---

<section class="relative overflow-hidden bg-bg">
  <div class="absolute inset-0" data-parallax="5">
    <Picture
      src={headerPhoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/92 to-primary/92 lg:to-primary/35 lg:[--tw-gradient-via-position:calc(max(0px,(100%_-_1200px)/2)_+_792px)]"></div>
  </div>

  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full border border-secondary/35" data-drift="7"></div>
  <div class="absolute -bottom-28 -right-28 w-96 h-96 rounded-full border border-secondary/25" data-drift="-5"></div>

  <div class:list={['relative max-w-[1200px] mx-auto px-6', compact ? 'py-8 md:py-14' : 'py-16 md:py-20']}>
    <div class="max-w-3xl" data-reveal>
      <h1 class:list={[compact ? 'text-3xl' : 'text-4xl', 'md:text-5xl font-bold text-white leading-tight']}>
        {title}
      </h1>
      <div class:list={['w-20 h-1 bg-secondary', compact ? 'mt-4 md:mt-6' : 'mt-6']} data-bar></div>
      {subtitle && (
        <p class:list={['text-lg md:text-xl text-white whitespace-pre-line', compact ? 'mt-4 md:mt-6' : 'mt-6']}>
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
