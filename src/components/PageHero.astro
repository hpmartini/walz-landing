---
import { Picture } from 'astro:assets';
import headerPhoto from '../assets/team/header_Unterseite.jpg';
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-bg">
  <div class="absolute inset-0" data-parallax="5">
    <Picture
      src={headerPhoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/70 to-primary/35"></div>
  </div>

  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full border border-secondary/35" data-drift="7"></div>
  <div class="absolute -bottom-28 -right-28 w-96 h-96 rounded-full border border-secondary/25" data-drift="-5"></div>

  <div class="relative max-w-[1200px] mx-auto px-6 py-16 md:py-20">
    <div class="max-w-3xl" data-reveal>
      <h1 class="text-4xl md:text-5xl font-bold text-white leading-tight">
        {title}
      </h1>
      <div class="w-20 h-1 bg-secondary mt-6" data-bar></div>
      {subtitle && (
        <p class="text-lg md:text-xl text-white mt-6 whitespace-pre-line">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
