---

---

<section class="relative overflow-hidden bg-night">
  <!-- Background image (parallax targets the img only; the overlay stays put) -->
  <div class="absolute inset-0" data-parallax="5">
    <img
      src="/images/team/header_Unterseite.jpg"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/80 to-primary/40"></div>
  </div>

  <div class="relative max-w-[1200px] mx-auto px-6 py-24 md:py-36">
    <div class="max-w-4xl">
      <p class="fx-eyebrow text-white/90" data-reveal="fade">
        Steuerberatung · Seit 2000 in Schwalmstadt
      </p>

      <h1 class="fx-h-display mt-6 text-white font-light uppercase" data-lines="load">
        <span class="block overflow-hidden"><span class="block" data-line>Ihr Steuerberater</span></span>
        <span class="block overflow-hidden"><span class="block" data-line>in Schwalmstadt.</span></span>
      </h1>

      <div class="w-24 h-px bg-secondary mt-8" data-reveal="fade" data-reveal-delay="0.35"></div>

      <p class="text-lg md:text-xl text-white/90 leading-relaxed mt-8 max-w-2xl" data-reveal data-reveal-delay="0.45">
        Seit 2000 vertrauen uns Unternehmer, Selbstständige und Privatpersonen.
        Persönlich, kompetent, regional verwurzelt.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mt-10" data-reveal-group data-reveal-delay="0.6">
        <a
          href="/kontakt"
          class="bg-white text-primary px-8 py-4 text-sm font-bold uppercase tracking-[0.16em] text-center transition-colors duration-300 hover:bg-cream"
        >
          Termin vereinbaren
        </a>
        <a
          href="/leistungen"
          class="border border-white/60 text-white px-8 py-4 text-sm font-bold uppercase tracking-[0.16em] text-center transition-colors duration-300 hover:border-white hover:bg-white/10"
        >
          Leistungen entdecken
        </a>
      </div>
    </div>
  </div>
</section>
