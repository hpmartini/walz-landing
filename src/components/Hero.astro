---
import { Picture } from 'astro:assets';
import headerPhoto from '../assets/team/header_Unterseite.jpg';

// Below md the hero fills exactly the screen under the sticky header (svh = small viewport, so the
// Android/iOS browser bars never cover the CTAs); type scales with min(height, width) via clamp().
---

<section class="relative overflow-hidden bg-bg flex flex-col min-h-[calc(100svh-var(--header-h))] pt-4 pb-4 md:min-h-0 md:py-[clamp(4rem,9svh,7rem)]">
  <!-- Background image (parallax targets the img only; the overlay stays put) -->
  <div class="absolute inset-0" data-parallax="5">
    <Picture
      src={headerPhoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/92 to-primary/92 lg:to-primary/30 lg:[--tw-gradient-via-position:calc(max(0px,(100%_-_1200px)/2)_+_792px)]"></div>
  </div>

  <!-- Decorative geometry (drifts against the scroll + breathes slowly) -->
  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full border border-secondary/40" data-drift="7"></div>
  <div class="absolute -bottom-28 -right-28 w-96 h-96 rounded-full border border-secondary/30" data-drift="-5"></div>

  <div class="relative flex-1 flex flex-col w-full max-w-[1200px] mx-auto px-6">
    <div class="flex-1 flex flex-col max-w-3xl">
      <h1 class="text-[length:clamp(24px,min(4.2svh,8vw),34px)] sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" data-lines="load">
        <span class="block overflow-hidden"><span class="block pb-[0.1em]" data-line>Ihr Steuerberater in Schwalmstadt</span></span>
        <span class="mt-3 md:mt-5 inline-block rounded-lg border border-white/40 bg-white/10 px-3 py-1.5 md:px-4 md:py-2 text-[length:clamp(12px,min(1.9svh,3.6vw),14px)] sm:text-base font-semibold normal-case tracking-normal leading-snug text-white"><!-- nowrap groups: breaks only before "Unternehmer" or "Privatpersonen" (on 320 px also after the first word) -->Generationenübergreifend <span class="whitespace-nowrap">vertrauen uns</span> <span class="whitespace-nowrap">Unternehmer, Selbstständige,</span> <span class="whitespace-nowrap">Privatpersonen und Vereine.</span></span>
      </h1>
      <div class="w-28 h-1 bg-secondary mt-4 mb-4 md:mt-6 md:mb-8" data-bar></div>
      <p class="text-[length:clamp(13px,min(2.35svh,4.4vw),18px)] leading-normal md:text-xl md:leading-relaxed text-white md:mb-10" data-reveal>
        Ob Sie ein Unternehmen gründen, laufende steuerliche Aufgaben abgeben oder Ihre private Steuererklärung erstellen lassen möchten: Die Kanzlei Karsten Walz unterstützt Sie bei Ihren nächsten Schritten. Lernen Sie unsere Leistungen und die Menschen dahinter kennen.
      </p>
      <!-- mt-auto pins the CTA block to the bottom of the screen-high mobile hero -->
      <div class="mt-auto pt-4 md:pt-0" data-reveal-group>
        <div class="flex gap-3 md:gap-4">
          <a
            href="/kontakt?anliegen=erstgespraech"
            aria-describedby="hero-cta-note"
            class="flex-1 md:flex-none flex items-center justify-center bg-white text-primary px-3 py-3 md:px-8 md:py-4 rounded-lg font-semibold text-[length:clamp(14px,min(2.1svh,3.9vw),16px)] md:text-base leading-snug transition-all duration-300 hover:brightness-105 motion-reduce:transition-none text-center"
            data-magnetic
          >
            Erstgespräch anfragen
          </a>
          <a
            href="#leistungen"
            class="flex-1 md:flex-none flex items-center justify-center border-2 border-white/70 text-white px-3 py-3 md:px-8 md:py-4 rounded-lg font-semibold text-[length:clamp(14px,min(2.1svh,3.9vw),16px)] md:text-base leading-snug transition-all duration-300 hover:bg-white hover:text-primary motion-reduce:transition-none text-center"
            data-magnetic
          >
            Passende Leistung finden
          </a>
        </div>
        <p id="hero-cta-note" class="mt-2 md:mt-3 max-w-md text-[length:clamp(12px,min(1.8svh,3.4vw),14px)] md:text-sm leading-snug text-white/90">Sie schildern uns kurz Ihr Anliegen. Anschließend klären wir gemeinsam, ob und wie wir Sie unterstützen können.</p>
      </div>
    </div>
  </div>
</section>
