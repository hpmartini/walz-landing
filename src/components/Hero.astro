---
import { Picture } from 'astro:assets';
import headerPhoto from '../assets/team/header_Unterseite.jpg';

---

<section class="relative overflow-hidden py-20 md:py-28 bg-bg">
  <!-- Background image (parallax targets the img only; the overlay stays put) -->
  <div class="absolute inset-0" data-parallax="5">
    <Picture
      src={headerPhoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/92 to-primary/92 lg:to-primary/30 lg:[--tw-gradient-via-position:calc(max(0px,(100%_-_1200px)/2)_+_792px)]"></div>
  </div>

  <!-- Decorative geometry (drifts against the scroll + breathes slowly) -->
  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full border border-secondary/40" data-drift="7"></div>
  <div class="absolute -bottom-28 -right-28 w-96 h-96 rounded-full border border-secondary/30" data-drift="-5"></div>

  <div class="relative max-w-[1200px] mx-auto px-6">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" data-lines="load">
        <span class="block overflow-hidden"><span class="block" data-line>Ihr Steuerberater in Schwalmstadt</span></span>
        <span class="mt-5 inline-block rounded-lg border border-white/40 bg-white/10 px-4 py-2 text-sm sm:text-base font-semibold normal-case tracking-normal leading-snug text-white"><!-- nowrap groups: breaks only before "Unternehmer" or "Privatpersonen" (on 320 px also after the first word) -->Generationenübergreifend <span class="whitespace-nowrap">vertrauen uns</span> <span class="whitespace-nowrap">Unternehmer, Selbstständige,</span> <span class="whitespace-nowrap">Privatpersonen und Vereine.</span></span>
      </h1>
      <div class="w-28 h-1 bg-secondary mt-6 mb-8" data-bar></div>
      <p class="text-xl text-white leading-relaxed mb-10" data-reveal>
        Ob Sie ein Unternehmen gründen, laufende steuerliche Aufgaben abgeben oder Ihre private Steuererklärung erstellen lassen möchten: Die Kanzlei Karsten Walz unterstützt Sie bei Ihren nächsten Schritten. Lernen Sie unsere Leistungen und die Menschen dahinter kennen.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-start gap-4" data-reveal-group>
        <div class="flex flex-col gap-3 sm:max-w-xs">
        <a
          href="/kontakt?anliegen=erstgespraech"
          aria-describedby="hero-cta-note"
          class="bg-white text-primary px-8 py-4 rounded-lg font-semibold transition-all duration-300 hover:brightness-105 motion-reduce:transition-none text-center"
          data-magnetic
        >
          Erstgespräch anfragen
        </a>
        <p id="hero-cta-note" class="text-sm text-white/90">Sie schildern uns kurz Ihr Anliegen. Anschließend klären wir gemeinsam, ob und wie wir Sie unterstützen können.</p>
        </div>
        <a
          href="#leistungen"
          class="border-2 border-white/70 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 hover:bg-white hover:text-primary motion-reduce:transition-none text-center"
          data-magnetic
        >
          Passende Leistung finden
        </a>
      </div>
    </div>
  </div>
</section>
