---
import { Picture } from 'astro:assets';
import heroBg from '../assets/brand/bg-web.jpg';
import standUp from '../assets/photos/stand-up.jpg';

// Title size at lg follows the text column (cqi), so "Ihr Steuerberater" always fits on one line.
// Box text: on phones nowrap groups keep the breaks before "Unternehmer" and "Privatpersonen"; from sm it
// is balanced and capped at 30.5em, so it breaks after "Unternehmer," and the box hugs the text. Its fill is a
// Deep Mauve scrim, because a white fill lifts the photo and drops the text contrast to about 2:1.
---

<!--
  Hero (owner decision): the approved title, box and lead are back. The hero fills the screen
  under the sticky header on every width; below md the CTAs are pinned to the bottom, from md the
  content sits centred. The background is the legacy stamp photo, multiplied into Deep Mauve:
  white paper becomes the brand colour, stamp and imprint stay visible as deeper tones and white
  text can never drop below white-on-mauve.
-->

<section class="on-dark relative overflow-hidden bg-bg flex flex-col min-h-[calc(100svh-var(--header-h))]">
  <!-- Background image (parallax targets the img only; the multiply layer and the gradient stay put) -->
  <div class="absolute inset-0 isolate" data-parallax="5">
    <Picture
      src={heroBg}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover object-[62%_50%] lg:object-[50%_85%]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-primary mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-primary/90 via-primary/55 to-transparent lg:via-primary/40"></div>
  </div>

  <!-- Decorative geometry (drifts against the scroll + breathes slowly). The ring that crosses the
       title stays faint: it must not lift the background under the white headline. -->
  <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full border border-secondary/15" data-drift="7"></div>
  <div class="absolute -bottom-28 -right-28 w-96 h-96 rounded-full border border-secondary/30" data-drift="-5"></div>

  <div class="relative flex-1 flex flex-col justify-center lg:flex-row lg:items-center lg:gap-12 w-full max-w-[1200px] mx-auto px-6 py-6 md:py-[clamp(1.5rem,6svh,7rem)] short:py-2">
    <div class="@container flex flex-col max-w-3xl lg:max-w-none lg:min-w-0 flex-1 md:flex-none lg:flex-1">
      <h1 class="uppercase text-[length:clamp(24px,min(4.2svh,8vw),34px)] sm:text-4xl md:text-[length:clamp(30px,6.7svh,48px)] lg:text-[length:clamp(30px,min(6.7svh,9.4cqi),60px)] font-bold text-white leading-tight" data-lines="load">
        <span class="block overflow-hidden"><span class="block pb-[0.1em]" data-line>Ihr Steuerberater <span class="whitespace-nowrap">in Schwalmstadt</span></span></span>
        <span class="mt-3 md:mt-5 short:mt-1.5 inline-block rounded-lg border border-white/40 bg-primary/40 px-3 py-1.5 md:px-4 md:py-2 text-[length:clamp(12px,min(1.9svh,3.6vw),14px)] sm:text-base font-semibold normal-case tracking-normal leading-snug text-white sm:text-balance sm:max-w-[30.5em]">Generationenübergreifend <span class="whitespace-nowrap">vertrauen uns</span> <span class="whitespace-nowrap sm:whitespace-normal">Unternehmer, Selbstständige,</span> <span class="whitespace-nowrap">Privatpersonen und Vereine.</span></span>
      </h1>
      <div class="w-28 h-1 bg-secondary mt-4 mb-4 md:mt-6 md:mb-8 short:my-2" data-bar></div>
      <p class="text-[length:clamp(14px,min(2.35svh,4.4vw),18px)] leading-normal md:text-[length:clamp(16px,2.8svh,20px)] md:leading-relaxed text-white" data-reveal>
        Ob Sie ein Unternehmen gründen, laufende steuerliche Aufgaben abgeben oder Ihre private Steuererklärung erstellen lassen möchten: Die Kanzlei Karsten Walz unterstützt Sie bei Ihren nächsten Schritten. Lernen Sie unsere Leistungen und die Menschen dahinter kennen.
      </p>
      <!-- mt-auto pins the CTA block to the bottom of the screen-high hero below md -->
      <div class="mt-auto pt-6 md:mt-0 md:pt-8 short:pt-3" data-reveal-group>
        <div class="flex gap-3 md:gap-4">
          <a
            href="/kontakt?anliegen=erstgespraech"
            class="flex-1 md:flex-none flex items-center justify-center bg-white text-primary px-3 py-3 md:px-8 md:py-4 rounded-lg font-semibold text-[length:clamp(14px,min(2.1svh,3.9vw),16px)] md:text-base leading-snug transition-all duration-300 hover:brightness-105 motion-reduce:transition-none text-center"
            data-magnetic
          >
            Erstgespräch anfragen
          </a>
          <a
            href="#leistungen"
            class="flex-1 md:flex-none flex items-center justify-center border-2 border-white/70 text-white px-3 py-3 md:px-8 md:py-4 rounded-lg font-semibold text-[length:clamp(14px,min(2.1svh,3.9vw),16px)] md:text-base leading-snug transition-all duration-300 hover:bg-white hover:text-primary motion-reduce:transition-none text-center"
            data-magnetic
          >
            Passende Leistung finden
          </a>
        </div>
      </div>
    </div>

    <!-- Photo from lg up, framed like the title box (white hairline over a mauve scrim) with a Rose Ash
         outline offset behind it. Lazy: hidden below lg, so phones never download it. -->
    <figure class="hidden lg:block [@media(max-height:699px)]:hidden relative shrink-0 w-[46%] max-w-[560px]" data-reveal data-tilt>
      <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-2xl border border-secondary/60" aria-hidden="true" data-tilt-shadow></div>
      <div class="relative rounded-2xl border border-white/40 bg-primary/40 p-2 shadow-2xl" data-tilt-photo>
        <Picture
          src={standUp}
          formats={['avif', 'webp']}
          widths={[560, 840, 1120]}
          sizes="(min-width: 1260px) 544px, 44vw"
          alt="Karsten Walz im Gespräch mit Mitarbeitenden in der Kanzlei"
          class="block w-full h-auto rounded-xl"
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>
