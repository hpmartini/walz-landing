---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kanzlei Karsten Walz - Ihr Steuerberater in Schwalmstadt seit 2000" } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Pre-paint motion opt-in: must run before any content paints.
         fx-motion = JS motion layer active (never under reduced motion).
         fx-entrance = additionally gate the pre-paint hide + entrance
         choreography to FRESH visits (external referrer or reload). Internal
         navigations keep content visible from the first frame so the
         cross-document view transition fades into a fully rendered page. -->
    <script is:inline>
      try{
        if(!matchMedia("(prefers-reduced-motion: reduce)").matches){
          var d=document.documentElement;
          d.classList.add("fx-motion");
          var n=performance.getEntriesByType("navigation")[0];
          var internal=document.referrer.indexOf(location.origin)===0;
          if(!internal||(n&&n.type==="reload"))d.classList.add("fx-entrance");
        }
      }catch(e){}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Kanzlei Karsten Walz</title>
  </head>
  <body class="bg-bg text-text">
    <div data-page>
      <slot />
    </div>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
