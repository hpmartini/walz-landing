---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kanzlei Karsten Walz - Ihr Steuerberater in Schwalmstadt seit 2000" } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Pre-paint motion opt-in: the stylesheet hides entrance elements only
         under html.fx-motion, so users without JS or with reduced motion
         never see hidden content. Must run before any content paints. -->
    <script is:inline>
      try{if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("fx-motion")}catch(e){}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Kanzlei Karsten Walz</title>
  </head>
  <body class="bg-bg text-text">
    <div data-page>
      <slot />
    </div>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
