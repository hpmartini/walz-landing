---
import '../styles/global.css'
import services from '../data/services.json';
import { kanzlei, SITE } from '../data/kanzlei';
import { SEO } from '../data/seo';

interface Props {
  /** Fallback for pages without an entry in data/seo.ts (e.g. 404). */
  title: string;
  description?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page (e.g. FAQPage, Service). */
  schema?: Record<string, unknown>[];
}

const { title, noindex = false, schema = [] } = Astro.props;
// Internal links have no trailing slash, so the canonical doesn't either.
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = new URL(path, SITE).href;
const seo = SEO[path];
const fullTitle = seo?.title ?? `${title} | ${kanzlei.name}`;
const description = seo?.description ?? Astro.props.description ?? kanzlei.description;
const ogImage = new URL('/og-image.jpg', SITE).href;
const business = {
  '@type': 'AccountingService',
  '@id': `${SITE}/#kanzlei`,
  name: kanzlei.name,
  description: kanzlei.description,
  url: `${SITE}/`,
  logo: new URL('/images/brand/logo.png', SITE).href,
  image: ogImage,
  telephone: kanzlei.phoneIntl,
  email: kanzlei.email,
  sameAs: Object.values(kanzlei.profiles),
  address: {
    '@type': 'PostalAddress',
    streetAddress: kanzlei.street,
    postalCode: kanzlei.postalCode,
    addressLocality: kanzlei.city,
    addressRegion: kanzlei.region,
    addressCountry: 'DE',
  },
  areaServed: [kanzlei.city, 'Schwalm-Eder-Kreis', kanzlei.region],
  openingHoursSpecification: kanzlei.hours.flatMap((h) =>
    h.slots.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens, closes }))
  ),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungen',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, url: `${SITE}/leistungen/${s.slug}` },
    })),
  },
};
// Breadcrumb mirrors the visible navigation: Startseite > section > service.
const LABELS: Record<string, string> = {
  leistungen: 'Leistungen', kanzlei: 'Kanzlei', team: 'Team', karriere: 'Karriere',
  kontakt: 'Kontakt', impressum: 'Impressum', datenschutz: 'Datenschutz',
  ...Object.fromEntries(services.map((s) => [s.slug, s.title])),
};
const segments = path.split('/').filter(Boolean);
const breadcrumb = !noindex && segments.length > 0 && segments.every((seg) => LABELS[seg]) && {
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Startseite', url: `${SITE}/` }, ...segments.map((seg, i) => ({
    name: LABELS[seg], url: `${SITE}/${segments.slice(0, i + 1).join('/')}`,
  }))].map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: item.url })),
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [business, ...(breadcrumb ? [breadcrumb] : []), ...schema] };
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={kanzlei.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Pre-paint motion opt-in: must run before any content paints.
         fx-motion = JS motion layer active (never under reduced motion).
         fx-entrance = additionally gate the pre-paint hide + entrance
         choreography to FRESH visits (external referrer or reload). Internal
         navigations keep content visible from the first frame so the
         cross-document view transition fades into a fully rendered page. -->
    <script is:inline>
      try{
        if(!matchMedia("(prefers-reduced-motion: reduce)").matches){
          var d=document.documentElement;
          d.classList.add("fx-motion");
          var n=performance.getEntriesByType("navigation")[0];
          var internal=document.referrer.indexOf(location.origin)===0;
          if(!internal||(n&&n.type==="reload"))d.classList.add("fx-entrance");
        }
      }catch(e){}
    </script>
    <link rel="preload" href="/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="bg-bg text-text">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] bg-primary text-white px-5 py-3 rounded-lg font-semibold">Zum Inhalt springen</a>
    <div data-page>
      <slot />
    </div>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
