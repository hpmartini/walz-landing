---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Anliegen from '../components/Anliegen.astro';
import Services from '../components/Services.astro';
import Trust from '../components/Trust.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/kanzlei';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { FEATURES } from '../data/features';
---

<Layout title="Startseite" schema={[faqSchema]}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Anliegen />
    <Trust />
    <About />
    <Services />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
  {FEATURES.chat && <ChatWidget />}
</Layout>
