---
import { kanzlei, SITE } from '../../data/kanzlei';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import ChatWidget from '../../components/ChatWidget.astro';
import { FEATURES } from '../../data/features';
import Faq from '../../components/Faq.astro';

import services from '../../data/services.json';

type Service = (typeof services)[number] & {
  sections?: { h2: string; text: string }[];
  related?: { label: string; href: string }[];
  faq?: { q: string; a: string }[];
  afterBenefits?: string;
  cta: { text?: string; label: string };
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const service = Astro.props.service as Service;
const serviceSchema = {
  '@type': 'Service',
  name: service.title,
  description: service.longDesc,
  url: `${SITE}/leistungen/${service.slug}`,
  provider: { '@id': `${SITE}/#kanzlei` },
  areaServed: 'Schwalmstadt',
};
// FAQPage only where the FAQ is rendered on the page (same data source).
const schema: Record<string, unknown>[] = service.faq
  ? [serviceSchema, {
      '@type': 'FAQPage',
      mainEntity: service.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    }]
  : [serviceSchema];
// Section texts mark inline links as [label](/href); split yields text, label, href, text, …
const parts = (text: string) => text.split(/\[([^\]]+)\]\(([^)]+)\)/);
const linkClass = 'text-primary font-semibold underline decoration-secondary underline-offset-4 hover:text-primary-light';
---

<Layout title={service.title} description={service.shortDesc.replace("\n", " ")} schema={schema}>
  <Header />

  <main id="main" tabindex="-1">
    <PageHero title={service.h1} subtitle={service.intro} />

    <section class="py-16 md:py-20 bg-bg">
      <div class="max-w-[1000px] mx-auto px-6">
        <div class="grid lg:grid-cols-3 gap-10 items-start">
          <article class="lg:col-span-2" data-reveal>
            {service.sections?.map(({ h2, text }) => (
              <div class="mb-12">
                <h2 class="text-2xl md:text-3xl text-primary">{h2}</h2>
                <div class="w-16 h-1 bg-secondary mt-5 mb-8"></div>
                <p class="text-text text-lg">
                  {parts(text).map((p, i, all) => i % 3 === 1 ? <a href={all[i + 1]} class={linkClass}>{p}</a> : i % 3 === 2 ? null : p)}
                </p>
              </div>
            ))}

            <div>
              <h2 class="text-xl font-semibold text-primary">Das bekommen Sie bei uns</h2>
              <div class="w-12 h-0.5 bg-secondary/80 mt-3 mb-6"></div>
              <ul class="space-y-3">
                {service.benefits.map((b) => (
                  <li class="flex gap-3 items-start">
                    <span class="mt-1.5 w-6 h-6 rounded-full bg-secondary/15 border border-secondary/25 flex items-center justify-center">
                      <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span class="text-text">{b}</span>
                  </li>
                ))}
              </ul>
              {service.afterBenefits && <p class="text-text text-lg mt-8">{service.afterBenefits}</p>}
            </div>

            {service.related && (
              <p class="mt-10 text-text">
                Passende Leistung:{' '}
                {service.related.map(({ label, href }) => <a href={href} class={linkClass}>{label}</a>)}
              </p>
            )}

            {service.cta.text && <p class="mt-12 text-xl font-semibold text-primary">{service.cta.text}</p>}
            <div class:list={['flex flex-col sm:flex-row gap-4', service.cta.text ? 'mt-6' : 'mt-12']}>
              <a href={`/kontakt?anliegen=${service.anliegen}`} class="bg-primary text-white px-7 py-3 rounded-lg font-semibold transition-all duration-300 hover:bg-primary-light hover:scale-105 motion-reduce:transition-none motion-reduce:hover:scale-100 text-center">
                {service.cta.label}
              </a>
              <a href="/leistungen" class="border-2 border-primary text-primary px-7 py-3 rounded-lg font-semibold transition-all duration-300 hover:bg-primary hover:text-white hover:scale-105 motion-reduce:transition-none motion-reduce:hover:scale-100 text-center">
                Zur Übersicht
              </a>
            </div>
          </article>

          <aside data-reveal>
            <div class="bg-white rounded-2xl border border-secondary/15 shadow-sm p-7">
              <div class="text-xs font-semibold text-text tracking-widest uppercase">Kontakt</div>
              <h3 class="text-xl text-primary mt-2">Sprechen wir darüber</h3>
              <p class="text-text mt-3">
                Ein kurzes Gespräch reicht oft, um die nächsten Schritte zu klären.
              </p>

              <div class="mt-6 space-y-3">
                <a href={kanzlei.phoneHref} class="flex items-center justify-between gap-4 rounded-xl border border-secondary/20 px-4 py-3 hover:bg-secondary/10 transition-all duration-300">
                  <span class="font-semibold text-primary">{kanzlei.phone}</span>
                  <span class="text-text">Anrufen</span>
                </a>
                <a href={`mailto:${kanzlei.email}`} class="flex items-center justify-between gap-4 rounded-xl border border-secondary/20 px-4 py-3 hover:bg-secondary/10 transition-all duration-300">
                  <span class="font-semibold text-primary">E-Mail</span>
                  <span class="text-text">Schreiben</span>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {service.faq && <Faq items={service.faq} />}
  </main>

  <Footer />
  {FEATURES.chat && <ChatWidget />}
</Layout>
