---
import { kanzlei } from '../data/kanzlei';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { FEATURES } from '../data/features';
import { ANLIEGEN } from '../data/anliegen';

const address = `${kanzlei.street}, ${kanzlei.postalCode} ${kanzlei.city}`;
const mapQuery = encodeURIComponent(address);
const inputClass = 'w-full rounded-lg border border-secondary/25 bg-white px-4 py-3 outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 aria-[invalid=true]:border-error';
---

<Layout title="Kontakt" description="Kontakt zur Kanzlei Karsten Walz – Adresse, Öffnungszeiten, Telefon, E-Mail und Anfrageformular.">
  <Header />

  <main id="main" tabindex="-1">
    <PageHero title="Erstgespräch oder Rückruf anfragen" subtitle="Beschreiben Sie kurz, wobei Sie Unterstützung suchen. Wir prüfen Ihr Anliegen und melden uns, um die nächsten Schritte mit Ihnen abzustimmen." />

    <section class="py-16 md:py-20 bg-bg">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-10 items-start">
          <div data-reveal>
            <h2 class="text-2xl md:text-3xl text-primary">Worum geht es bei Ihrer Anfrage</h2>
            <div class="w-16 h-1 bg-secondary mt-5 mb-8"></div>

            <form id="contact-form" class="bg-white rounded-2xl border border-secondary/15 shadow-sm p-6 sm:p-8" method="post" action="/api/kontakt" novalidate data-mail={kanzlei.email} data-phone={kanzlei.phone} data-phone-href={kanzlei.phoneHref}>
              <div class="hidden" aria-hidden="true">
                <label for="website">Website</label>
                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <p class="text-sm text-text mb-5">Pflichtfelder sind mit * markiert.</p>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-primary mb-2" for="name">Name *</label>
                  <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" class={inputClass} />
                </div>
                <div>
                  <label class="block text-sm font-medium text-primary mb-2" for="phone">Telefon (optional)</label>
                  <input id="phone" name="phone" type="tel" maxlength="40" autocomplete="tel" class={inputClass} />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-sm font-medium text-primary mb-2" for="email">E-Mail *</label>
                  <input id="email" name="email" type="email" required maxlength="200" autocomplete="email" inputmode="email" class={inputClass} />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-sm font-medium text-primary mb-2" for="anliegen">Ihr Anliegen *</label>
                  <select id="anliegen" name="anliegen" required class={inputClass}>
                    <option value="">Bitte auswählen</option>
                    {ANLIEGEN.map((a) => <option value={a}>{a}</option>)}
                  </select>
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-sm font-medium text-primary mb-2" for="message">Ihr Anliegen in wenigen Sätzen *</label>
                  <textarea id="message" name="message" rows="5" required maxlength="5000" aria-describedby="message-hint" class={inputClass} placeholder="Zum Beispiel: Ich plane eine Gründung in Schwalmstadt und suche Unterstützung bei der Rechtsformwahl und Finanzplanung."></textarea>
                  <p id="message-hint" class="mt-2 text-sm text-text">Für die erste Anfrage genügt eine kurze Beschreibung. Bescheide, Steuerunterlagen und andere vertrauliche Dokumente besprechen wir anschließend über einen geeigneten Übermittlungsweg.</p>
                </div>
              </div>

              <div class="mt-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
                <button type="submit" class="shrink-0 bg-primary text-white px-7 py-3 rounded-lg font-semibold transition-all duration-300 hover:bg-primary-light hover:scale-105 aria-disabled:opacity-70 aria-disabled:cursor-wait aria-disabled:hover:bg-primary aria-disabled:hover:scale-100 motion-reduce:transition-none motion-reduce:hover:scale-100">
                  Anfrage senden
                </button>
                <p class="text-sm text-text">
                  Ihre Angaben verwenden wir zur Bearbeitung Ihrer Anfrage. Einzelheiten finden Sie in unserer <a class="text-primary font-semibold a-underline" href="/datenschutz">Datenschutzerklärung</a>.
                </p>
              </div>

              <div id="contact-status" role="status" aria-live="polite" class="mt-6 rounded-lg border border-secondary/25 bg-bg-alt p-4 text-sm text-text empty:hidden"></div>
            </form>

            <div class="mt-8 bg-bg-alt rounded-2xl border border-secondary/15 p-8">
              <h3 class="text-xl text-primary">Direktkontakt</h3>
              <div class="w-12 h-0.5 bg-secondary/80 mt-3"></div>
              <div class="mt-5 space-y-3 text-text">
                <div class="flex items-center gap-3">
                  <span class="w-9 h-9 rounded-xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </span>
                  <a class="text-primary font-semibold a-underline" href={kanzlei.phoneHref}>{kanzlei.phone}</a>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-9 h-9 rounded-xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l9 6 9-6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 8v10a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                  </span>
                  <a class="text-primary font-semibold a-underline" href={`mailto:${kanzlei.email}`}>{kanzlei.email}</a>
                </div>
              </div>

              <div class="mt-8">
                <div class="text-primary font-semibold">Öffnungszeiten</div>
                <div class="text-text mt-3 text-sm space-y-1">
                  {kanzlei.hours.map((h) => (
                    <div class="flex items-center justify-between gap-6"><span>{h.label}</span><span>{h.slots.map(([a, b], i) => <>{i > 0 && <br />}{a} – {b} Uhr</>)}</span></div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div data-reveal>
            <h2 class="text-2xl md:text-3xl text-primary">Anfahrt</h2>
            <div class="w-16 h-1 bg-secondary mt-5 mb-8"></div>

            <div class="bg-white rounded-2xl border border-secondary/15 shadow-sm overflow-hidden">
              <div id="map-consent" data-query={mapQuery} data-address={address} class="h-[420px] bg-bg-alt flex flex-col items-center justify-center gap-5 p-8 text-center">
                <p class="text-text max-w-[34ch]">
                  Die Karte wird von Google Maps geladen. Dabei werden Daten wie Ihre IP-Adresse an Google übertragen.
                </p>
                <button id="map-load" type="button" class="bg-primary text-white px-7 py-3 rounded-lg font-semibold transition-all duration-300 hover:bg-primary-light hover:scale-105 motion-reduce:transition-none motion-reduce:hover:scale-100">
                  Karte laden
                </button>
                <p class="text-sm text-text">
                  Mehr in der <a class="text-primary font-semibold a-underline" href="/datenschutz">Datenschutzerklärung</a>
                  · <a class="text-primary font-semibold a-underline" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">In Google Maps öffnen</a>
                </p>
              </div>
            </div>

            <div class="mt-6 bg-bg-alt rounded-2xl border border-secondary/15 p-8">
              <div class="flex items-start gap-3">
                <span class="w-10 h-10 rounded-xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
                  <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10a2 2 0 100-4 2 2 0 000 4z"/></svg>
                </span>
                <div>
                  <div class="text-primary font-semibold">Adresse</div>
                  <div class="text-text mt-1">{address}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  {FEATURES.chat && <ChatWidget />}
</Layout>

<script>
  import { anliegenFromParam } from '../data/anliegen';

  const TEXT = {
    sending: 'Anfrage wird gesendet …',
    success: 'Vielen Dank. Ihre Anfrage wurde übermittelt. Wir melden uns, um Ihr Anliegen und die nächsten Schritte zu besprechen.',
    invalid: 'Bitte geben Sie Ihren Namen, eine gültige E-Mail-Adresse und Ihr Anliegen ein.',
  };

  function initMapConsent() {
    const consent = document.getElementById('map-consent');
    const button = document.getElementById('map-load');
    if (!consent || !button) return;
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      Object.assign(iframe, {
        title: `Google Maps: ${consent.dataset.address}`,
        src: `https://www.google.com/maps?q=${consent.dataset.query}&output=embed`,
        referrerPolicy: 'no-referrer-when-downgrade',
      });
      iframe.className = 'block w-full h-[420px] border-0';
      consent.replaceWith(iframe);
      iframe.focus();
    });
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-status');
    if (!form || !status) return;
    const { mail = '', phone = '', phoneHref = '' } = form.dataset;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = button.textContent?.trim() ?? '';
    const select = form.elements.namedItem('anliegen') as HTMLSelectElement;
    const required = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'));
    let inFlight = false;

    // Only ever selects one of the fixed options; the raw parameter is never rendered.
    const preset = anliegenFromParam(new URLSearchParams(location.search).get('anliegen'));
    if (preset) select.value = preset;

    const show = (html: string) => { status.innerHTML = html; };
    const link = (href: string, text: string) => `<a class="text-primary font-semibold a-underline" href="${href}">${text}</a>`;

    // Mail link carries the typed text so nothing is lost if the server is down.
    const mailtoFor = (data: FormData) => {
      const body = `${data.get('anliegen') ?? ''}\n\n${data.get('message') ?? ''}\n\n${data.get('name') ?? ''}\n${data.get('phone') ?? ''}`;
      return `mailto:${mail}?subject=${encodeURIComponent('Anfrage über die Website')}&body=${encodeURIComponent(body)}`;
    };
    const showError = (data: FormData) => show(
      `<p>Ihre Anfrage konnte gerade nicht übermittelt werden. Ihre Eingaben bleiben erhalten. Versuchen Sie es erneut oder schreiben Sie an ${link(mailtoFor(data), mail)}.</p>
       <p class="mt-1">Telefon: ${link(phoneHref, phone)}</p>`
    );
    const showSuccess = () => show(`<p class="text-primary font-semibold">${TEXT.success}</p>`);

    const fieldValid = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => el.value.trim() !== '' && el.checkValidity();
    const markFields = () => {
      let firstInvalid: HTMLElement | null = null;
      for (const el of required) {
        const ok = fieldValid(el);
        el.setAttribute('aria-invalid', String(!ok));
        const hint = el.id === 'message' ? 'message-hint' : '';
        el.setAttribute('aria-describedby', [ok ? '' : 'contact-status', hint].filter(Boolean).join(' '));
        if (!el.getAttribute('aria-describedby')) el.removeAttribute('aria-describedby');
        if (!ok && !firstInvalid) firstInvalid = el;
      }
      return firstInvalid;
    };
    required.forEach((el) => el.addEventListener('input', () => {
      if (el.getAttribute('aria-invalid') === 'true' && fieldValid(el)) markFields();
    }));

    const params = new URLSearchParams(location.search);
    if (params.get('status') === 'gesendet') showSuccess();
    if (params.get('status') === 'fehler') showError(new FormData(form));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (inFlight) return;
      const firstInvalid = markFields();
      if (firstInvalid) {
        show(`<p class="text-primary font-semibold">${TEXT.invalid}</p>`);
        firstInvalid.focus();
        return;
      }
      const data = new FormData(form);
      inFlight = true;
      button.setAttribute('aria-disabled', 'true');
      button.textContent = TEXT.sending;
      show('');
      try {
        const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        showSuccess();
      } catch {
        showError(data);
      } finally {
        inFlight = false;
        button.removeAttribute('aria-disabled');
        button.textContent = label;
      }
    });
  }

  initMapConsent();
  initContactForm();
</script>
